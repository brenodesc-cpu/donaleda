# Chaves da Agora (obrigatórias). Ficam em Agora Console → seu projeto.
NEXT_PUBLIC_AGORA_APP_ID=

# Só o servidor lê. Nunca vai pro navegador nem pro GitHub.
NEXT_AGORA_APP_CERTIFICATE=

# Endereço público deste servidor (https://...), sem barra no fim.
# A Agora precisa dele pra chamar as ações da assistente (anotar, avisar a família).
# Rodando no seu computador, use um túnel (ngrok http 3000) e cole o endereço aqui.
# Sem ele a conversa funciona, mas a ficha só recebe os avisos das regras fixas.
LIA_URL_PUBLICA=

# Opcionais
# WhatsApp que recebe o "Fale conosco" da landing, com 55 e o DDD, só números.
# Sem ele, o botão abre um e-mail. O número fica fora do GitHub, como as chaves.
# NEXT_PUBLIC_WHATSAPP_DE_CONTATO=5511999999999
# Nome da assistente (padrão: Lia)
# NEXT_PUBLIC_NOME_DA_ASSISTENTE=Lia
# Voz, no formato fornecedor:voz. Padrão openai:nova. Outras: openai:shimmer, minimax:<id>, elevenlabs:<id>
# LIA_VOZ=openai:nova
# Velocidade da voz da OpenAI (1 é o normal; 0.9 fala mais devagar)
# LIA_VELOCIDADE_DA_VOZ=0.9
# Modelo emprestado pela Agora: gpt-4o-mini (padrão), gpt-4.1-mini, gpt-5-nano, gpt-5-mini
# LIA_MODELO=gpt-4o-mini
# Vídeo da assistente (avatar), no formato fornecedor:id. Fornecedores: anam, heygen.
# Sem isso a tela mostra o rosto desenhado.
# LIA_AVATAR=anam:<id do avatar>
# LIA_AVATAR_KEY=
# Só pra voz da ElevenLabs
# LIA_ELEVENLABS_KEY=
# Mostra no terminal o pedido mandado à Agora
# LIA_DEPURAR=1

# Banco (Supabase). Ficam em supabase.com → projeto → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só o servidor lê. Nunca vai pro navegador nem pro GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Sinalização de chamada (Agora Signaling + Offline Push Android FCM / iOS APNs VoIP)
# Opcional: ativa envio em tempo real via Agora Signaling REST API
# NEXT_AGORA_CUSTOMER_ID=
# NEXT_AGORA_CUSTOMER_SECRET=
# Android (FCM HTTP v1): JSON inteiro da Service Account do Firebase (ou em base64)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# iOS (APNs VoIP / PushKit + CallKit)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=app.donaleda
# APNS_SANDBOX=0
# Segredo do agendador de ligações (/api/cron/chamadas)
# CRON_SECRET=
# Opcional: Agora Conversational AI Telephony (ligação telefônica real PSTN em massa pros parentes após 3 tentativas)
# AGORA_TELEPHONY_FROM_NUMBER=+1...
# AGORA_TELEPHONY_PIPELINE_ID=
# Demonstração pública em /experimente: minutos por dia somando todo mundo (60),
# ligações por pessoa por dia (3) e por rede (20), o vídeo de quando encher, e 1 fecha tudo.
# LIA_DEMO_MINUTOS_POR_DIA=60
# LIA_DEMO_LIGACOES_POR_VISITANTE=3
# LIA_DEMO_LIGACOES_POR_REDE=20
# LIA_DEMO_VIDEO=https://...
# LIA_DEMO_DESLIGADA=1
